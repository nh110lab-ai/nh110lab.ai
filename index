<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>NH110LAB.ai — Intelligence & Automations</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/inter-ui/3.19.3/inter.min.css">

<style>
/* ==========================================================
   ROOT THEME
========================================================== */
:root {
    --bg: #ffffff;
    --text: #0d0d0f;
    --subtext: #666;
    --card-bg: rgba(255,255,255,0.70);
    --nav-bg: rgba(255,255,255,0.82);
    --blue: #0a84ff;
    --transition-theme: .85s cubic-bezier(.25,.6,.3,1);
    --radius: 22px;
    --shadow: 0 20px 50px rgba(0,0,0,0.08);
}

/* Dark mode variables */
body.dark {
    --bg: #1a1a1a;
    --text: #f5f5f5;
    --subtext: #ccc;
    --card-bg: rgba(26,26,26,0.70);
    --nav-bg: rgba(26,26,26,0.82);
    --blue: #0a84ff;
}

/* ==========================================================
   GLOBAL
========================================================== */
* { margin:0; padding:0; box-sizing:border-box; }

body {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
    background: var(--bg);
    color: var(--text);
    transition: background var(--transition-theme), color var(--transition-theme);
    overflow-x: hidden;
}

section {
    padding: 100px 24px;
}

.section-inner {
    max-width: 1100px;
    margin:auto;
}

.section-title {
    font-size: 42px;
    font-weight: 800;
    margin-bottom: 10px;
    letter-spacing: -1px;
    opacity: 0;
    transform: translateY(20px);
    transition: 1s;
}
.section-title.active {
    opacity:1;
    transform: translateY(0);
}

.section-desc {
    font-size:18px;
    color:var(--subtext);
    max-width:650px;
    line-height:1.7;
    margin-bottom:50px;
}

/* ==========================================================
   HEADER — Animé
========================================================== */
header {
    position:fixed;
    top:0; left:0;
    width:100%;
    padding:26px 40px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:var(--nav-bg);
    backdrop-filter: blur(20px) saturate(1.3);
    transition:0.55s;
    z-index:1000;
}
header.active {
    padding:14px 40px;
    box-shadow:0 18px 40px rgba(0,0,0,0.08);
}

nav ul {
    display:flex; gap:34px;
    list-style:none;
}
nav a {
    text-decoration:none;
    color:var(--text);
    font-weight:500;
    transition:0.3s;
}
nav a:hover { color:var(--blue); }

/* ==========================================================
   HERO
========================================================== */
.hero {
    padding-top:180px;
    text-align:center;
    max-width:900px;
    margin:auto;
}

.hero h1 {
    font-size:68px;
    font-weight:800;
    line-height:1.05;
    letter-spacing:-2px;
}

.hero p {
    font-size:22px;
    opacity:0.7;
    margin-top:18px;
}

.btn-main {
    padding:16px 36px;
    background:var(--blue);
    border:none;
    color:white;
    border-radius:18px;
    font-size:20px;
    margin-top:40px;
    cursor:pointer;
    transition:0.3s;
    box-shadow:0 12px 35px rgba(10,132,255,0.35);
}
.btn-main:hover {
    transform:scale(1.05);
    filter:brightness(1.1);
}

/* ==========================================================
   GLOBAL REVEAL
========================================================== */
.reveal {
    opacity:0;
    transform:translateY(30px);
    transition:1.1s cubic-bezier(.25,.6,.3,1);
}
.reveal.active {
    opacity:1;
    transform:translateY(0);
}

/* ==========================================================
   CARD GRID + Premium style
========================================================== */
.cards-grid {
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));
    gap:25px;
}

.card {
    background:var(--card-bg);
    padding:28px;
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    transition:background var(--transition-theme),
               transform 0.35s ease,
               backdrop-filter .55s ease,
               box-shadow .35s ease;
    backdrop-filter: blur(18px);
}

.card:hover {
    transform:translateY(-8px) scale(1.03);
    box-shadow:0 35px 70px rgba(0,0,0,0.15);
    backdrop-filter: blur(26px) saturate(1.8);
}

.card h3 { font-size:20px; margin-bottom:8px; }
.card p { color:var(--subtext); line-height:1.65; }

/* ==========================================================
   PRICING
========================================================== */
.pricing-grid {
    display:flex;
    flex-wrap:wrap;
    gap:30px;
    justify-content:center;
}

.price-card {
    background:var(--card-bg);
    padding:40px 36px;
    width:320px;
    border-radius:24px;
    text-align:center;
    backdrop-filter:blur(22px);
}

.price-card h3 { font-size:28px; font-weight:700; margin-bottom:12px; }
.price-card .price { font-size:44px; margin:20px 0; font-weight:800; }
.price-card ul { list-style:none; line-height:1.8; padding:0; margin:0; }

/* FAQ */
.faq-item {
    margin-bottom:18px;
    border-bottom:1px solid rgba(0,0,0,0.08);
    padding-bottom:14px;
    cursor:pointer;
}
.faq-q {
    font-size:18px;
    font-weight:600;
}
.faq-a {
    max-height:0;
    overflow:hidden;
    opacity:0;
    transition:0.6s;
}
.faq-item.active .faq-a {
    max-height:200px;
    opacity:1;
    margin-top:8px;
}

/* CONTACT */
.contact-box {
    background:var(--card-bg);
    padding:40px;
    border-radius:24px;
    text-align:center;
    backdrop-filter:blur(18px);
}

/* MOBILE */
@media(max-width:800px) {
    .hero h1 { font-size:45px; }
    header nav ul { gap:20px; }
}
</style>
</head>
<body>

