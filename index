<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NH110LAB.ai — Intelligence & Automations</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/inter-ui/3.19.3/inter.min.css">

<style>
/* ==========================================================
   APPLE INTELLIGENCE THEME — amélioré ⭐⭐⭐⭐⭐
========================================================== */
:root {
    --bg: #ffffff;
    --text: #0d0d0f;
    --subtext: #666;

    --ios-glass: rgba(255,255,255,0.55);
    --glass-strong: rgba(255,255,255,0.75);
    --glass-dark: rgba(25,25,25,0.55);

    --blue: #0a84ff;
    --ai1: #9D6BFF;
    --ai2: #00C6FF;
    --ai3: #FF4DDE;

    --radius: 22px;
    --shadow: 0 25px 55px rgba(0,0,0,0.12);

    --transition-theme: .7s cubic-bezier(.25,.6,.3,1);
    --transition-soft: .45s ease;
}

/* Mode sombre (activé automatiquement en scroll) */
body.dark {
    --bg: #111111;
    --text: #f5f5f5;
    --subtext: #bbbbbb;
    --ios-glass: rgba(20,20,20,0.55);
    --glass-strong: rgba(20,20,20,0.75);
}

/* GLOBAL */
body {
    margin:0;
    font-family:"Inter", -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
    background:var(--bg);
    color:var(--text);
    overflow-x:hidden;
    transition:
        background var(--transition-theme),
        color var(--transition-theme);
}

a { text-decoration:none; color:inherit; }

/* SECTIONS */
section {
    padding:120px 24px;
    transition:var(--transition-theme);
}

.section-inner {
    max-width:1100px;
    margin:auto;
}

.section-title {
    font-size:42px;
    font-weight:800;
    opacity:0;
    transform:translateY(25px);
    transition:1s;
}
.section-title.active {
    opacity:1;
    transform:translateY(0);
}

.section-desc {
    font-size:18px;
    color:var(--subtext);
    max-width:650px;
    line-height:1.7;
    margin:18px 0 50px;
}

/* ==========================================================
   HEADER (Apple Glass + Scroll shrink)
========================================================== */
header {
    position:fixed;
    top:0; left:0;
    width:100%;
    padding:26px 40px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:var(--ios-glass);
    backdrop-filter:blur(25px) saturate(1.4);
    border-bottom:1px solid rgba(255,255,255,0.25);
    box-shadow:0 10px 40px rgba(0,0,0,0.05);
    transition:padding .5s ease, background .5s ease, box-shadow .5s;
    z-index:1000;
}
header.active {
    padding:12px 40px;
    box-shadow:0 20px 45px rgba(0,0,0,0.12);
}

nav ul {
    display:flex;
    gap:32px;
    list-style:none;
}
nav a {
    font-weight:500;
    transition:.3s;
}
nav a:hover {
    color:var(--blue);
}

/* ==========================================================
   HERO — Glass + Orb IA + Gradient Siri
========================================================== */
.hero {
    padding-top:190px;
    padding-bottom:170px;
    text-align:center;
    max-width:900px;
    margin:auto;
    position:relative;
}

.hero::before {
    content:"";
    position:absolute;
    top:-300px; left:50%;
    transform:translateX(-50%);
    width:900px; height:900px;
    background:radial-gradient(circle,
        rgba(255,255,255,0.9),
        rgba(255,255,255,0.1)
    );
    filter:blur(120px);
    border-radius:50%;
    z-index:-1;
    animation:heroOrb 12s ease-in-out infinite alternate;
}
@keyframes heroOrb {
    from { transform:translateX(-50%) scale(1); }
    to   { transform:translateX(-50%) scale(1.28); }
}

.hero h1 {
    font-size:70px;
    font-weight:900;
    line-height:1.05;
    background:linear-gradient(110deg, var(--ai1), var(--ai2), var(--ai3));
    -webkit-background-clip:text;
    color:transparent;
    animation:titleGlow 6s infinite alternate ease-in-out;
}
@keyframes titleGlow {
    from { filter:drop-shadow(0 0 8px rgba(0,0,0,0.2)); }
    to   { filter:drop-shadow(0 0 16px rgba(0,198,255,0.65)); }
}

.hero p {
    font-size:22px;
    opacity:.8;
    margin-top:18px;
}

.btn-main {
    margin-top:35px;
    padding:18px 40px;
    background:linear-gradient(120deg, var(--ai1), var(--ai2), var(--ai3));
    border:none;
    border-radius:20px;
    font-size:20px;
    color:white;
    cursor:pointer;
    transition:transform .3s, box-shadow .3s;
    box-shadow:0 18px 45px rgba(0,0,0,0.15);
}
.btn-main:hover {
    transform:scale(1.07);
    box-shadow:0 30px 70px rgba(0,0,0,0.22);
}

/* ==========================================================
   REVEAL ANIMATIONS
========================================================== */
.reveal {
    opacity:0;
    transform:translateY(40px);
    transition:1.1s cubic-bezier(.25,.6,.3,1);
}
.reveal.active {
    opacity:1;
    transform:translateY(0);
}
/* ==========================================================
   CARDS — Style VisionOS
========================================================== */
.cards-grid {
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));
    gap:28px;
}

.card {
    background:var(--glass-strong);
    padding:32px;
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    backdrop-filter:blur(22px) saturate(1.6);
    transition:transform .45s ease, backdrop-filter .45s ease, box-shadow .45s;
    border:1px solid rgba(255,255,255,0.44);
}

.card:hover {
    transform:translateY(-8px) scale(1.03);
    box-shadow:0 35px 75px rgba(0,0,0,0.15);
    backdrop-filter:blur(32px) saturate(2);
}

.card h3 { 
    font-size:21px; 
    font-weight:700;
    margin-bottom:10px; 
}
.card p { 
    color:var(--subtext); 
    line-height:1.65; 
}

/* ==========================================================
   PRICING — Apple Glass Panels
========================================================== */
.pricing-grid {
    display:flex;
    gap:32px;
    flex-wrap:wrap;
    justify-content:center;
}

.price-card {
    background:var(--glass-strong);
    padding:46px 40px;
    border-radius:26px;
    width:310px;
    text-align:center;
    backdrop-filter:blur(28px) saturate(1.6);
    box-shadow:var(--shadow);
    transition:.4s ease;
    border:1px solid rgba(255,255,255,0.44);
}

.price-card:hover {
    transform:translateY(-10px) scale(1.05);
    box-shadow:0 40px 85px rgba(0,0,0,0.18);
}

.price-card h3 {
    font-size:26px;
    font-weight:700;
    margin-bottom:12px;
}

.price {
    font-size:45px;
    font-weight:900;
    margin:22px 0;
    background:linear-gradient(110deg,var(--ai1),var(--ai2),var(--ai3));
    -webkit-background-clip:text;
    color:transparent;
}

.price-card ul {
    list-style:none; 
    padding:0;
    margin-top:16px;
    line-height:1.7;
    color:var(--subtext);
}

/* ==========================================================
   FAQ — Smooth expand
========================================================== */
.faq-item {
    padding:18px 0;
    border-bottom:1px solid rgba(0,0,0,0.08);
    cursor:pointer;
}
body.dark .faq-item {
    border-bottom-color:rgba(255,255,255,0.12);
}

.faq-q {
    font-size:19px; 
    font-weight:600;
}
.faq-a {
    max-height:0;
    opacity:0;
    overflow:hidden;
    transition:.6s;
}
.faq-item.active .faq-a {
    max-height:200px;
    opacity:1;
    margin-top:8px;
}

/* ==========================================================
   CONTACT — Liquid Glass Box
========================================================== */
.contact-box {
    background:var(--glass-strong);
    padding:55px;
    border-radius:30px;
    backdrop-filter:blur(34px) saturate(1.6);
    border:1px solid rgba(255,255,255,0.45);
    box-shadow:0 30px 85px rgba(0,0,0,0.15);
    text-align:center;
}

.contact-box p {
    font-size:20px;
    opacity:.85;
}

/* ==========================================================
   HALO IA — Light that follows cursor
========================================================== */
.cursor-halo {
    position:fixed;
    width:260px;
    height:260px;
    background:radial-gradient(circle,
        rgba(157,107,255,0.28),
        rgba(0,198,255,0.24),
        transparent 70%
    );
    border-radius:50%;
    pointer-events:none;
    filter:blur(85px);
    transform:translate(-50%, -50%);
    z-index:-2;
    opacity:.9;
    transition:.2s;
}

/* ==========================================================
   RESPONSIVE
========================================================== */
@media(max-width:800px){
    .hero h1 { font-size:46px; }
    .section-title { font-size:32px; }
    header { padding:18px 22px; }
    header.active { padding:12px 22px; }
}
</style>
</head>

<body>

<!-- HALO CURSEUR -->
<div class="cursor-halo"></div>

<header>
    <div class="logo" style="font-size:26px;font-weight:800;">NH110LAB.ai</div>
    <nav>
        <ul>
            <li><a href="#agents">Agents</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#pricing">Tarifs</a></li>
            <li><a href="#faq">FAQ</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>
</header>

<section class="hero">
    <h1>Des Agents IA<br>modernes & évolutifs</h1>
    <p>Créations intelligentes, autonomes et optimisées pour votre activité.</p>
    <button class="btn-main" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">Créer mon agent IA</button>
</section>
<script>
/* ==============================
   REVEAL ANIMATIONS
============================== */
const reveals = document.querySelectorAll(".reveal, .section-title");
const io = new IntersectionObserver((entries)=>{
    entries.forEach(entry=>{
        if(entry.isIntersecting) entry.target.classList.add("active");
    });
},{threshold:0.15});
reveals.forEach(el => io.observe(el));

/* ==============================
   HEADER SCROLL SHRINK
============================== */
window.addEventListener("scroll", ()=>{
    const h = document.querySelector("header");
    h.classList.toggle("active", window.scrollY > 40);
});

/* ==============================
   FAQ ACCORDION
============================== */
document.querySelectorAll(".faq-item").forEach(f=>{
    f.addEventListener("click", ()=> f.classList.toggle("active"));
});

/* ==============================
   CURSOR HALO
============================== */
const halo = document.querySelector(".cursor-halo");
document.addEventListener("mousemove", (e)=>{
    halo.style.left = e.pageX + "px";
    halo.style.top = e.pageY + "px";
});

/* ==============================
   DARK MODE INTELLIGENT — 
   Change automatiquement en scroll
============================== */
const body = document.body;
function updateTheme() {
    const scroll = window.scrollY;
    const vh = window.innerHeight;

    // Hero = clair
    if(scroll < vh * 1.2){
        body.classList.remove("dark");
        return;
    }

    // Services + Pricing = sombre
    if(scroll >= vh * 1.2 && scroll < vh * 3.5){
        body.classList.add("dark");
        return;
    }

    // Contact = clair
    if(scroll >= vh * 3.5){
        body.classList.remove("dark");
        return;
    }
}

window.addEventListener("scroll", updateTheme);
window.addEventListener("load", updateTheme);

/* ==============================
   PARTICULES SIRI LIGHT
============================== */
const canvas = document.createElement("canvas");
canvas.style.position="fixed";
canvas.style.top="0";
canvas.style.left="0";
canvas.style.width="100vw";
canvas.style.height="100vh";
canvas.style.zIndex="-3";
canvas.style.pointerEvents="none";
document.body.appendChild(canvas);

const ctx = canvas.getContext("2d");
let w, h;
function resize(){
    w = canvas.width = window.innerWidth;
    h = canvas.height = window.innerHeight;
}
resize();
window.addEventListener("resize", resize);

const particles = [];
for(let i=0;i<75;i++){
    particles.push({
        x:Math.random()*w,
        y:Math.random()*h,
        vx:(Math.random()-.5)*0.7,
        vy:(Math.random()-.5)*0.7,
        size:Math.random()*3+1,
        col: ["rgba(157,107,255,.7)", "rgba(0,198,255,.7)", "rgba(255,77,222,.7)"][Math.floor(Math.random()*3)]
    });
}

function loop(){
    ctx.clearRect(0,0,w,h);
    particles.forEach(p=>{
        p.x+=p.vx; p.y+=p.vy;
        if(p.x<0||p.x>w)p.vx*=-1;
        if(p.y<0||p.y>h)p.vy*=-1;
        ctx.beginPath();
        ctx.arc(p.x,p.y,p.size,0,Math.PI*2);
        ctx.fillStyle=p.col;
        ctx.shadowBlur=15;
        ctx.shadowColor=p.col;
        ctx.fill();
    });
    requestAnimationFrame(loop);
}
loop();
</script>
