<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Catalogue Agents IA — NH110LAB.ai</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/inter-ui/3.19.3/inter.min.css">

  <style>
    :root {
      --bg: #ffffff;
      --text: #0f0f11;
      --sub: #777;

      --ai1: #9D6BFF;
      --ai2: #00C6FF;
      --ai3: #FF4DDE;

      --glass1: rgba(255, 255, 255, 0.65);
      --glass2: rgba(255, 255, 255, 0.30);

      --radius: 26px;
      --transition: 0.85s cubic-bezier(.25,.6,.3,1);
    }

    * { margin:0; padding:0; box-sizing:border-box; }

    body {
      font-family:"Inter",-apple-system,BlinkMacSystemFont,"SF Pro Display",sans-serif;
      background:var(--bg);
      color:var(--text);
      overflow-x:hidden;
      opacity:0;
      animation:bodyFadeIn 1.4s ease forwards;
      transition:background-color var(--transition), color var(--transition);
    }

    @keyframes bodyFadeIn { to { opacity:1; } }

    a { color:inherit; text-decoration:none; }

    body.theme-dark {
      --bg: #050509;
      --text: #f5f5f8;
      --sub: #a4a4b5;
      --glass1: rgba(20, 20, 32, 0.85);
      --glass2: rgba(16, 16, 26, 0.65);
    }

    .bg-layer {
      position:fixed;
      top:0; left:0;
      width:100vw; height:100vh;
      pointer-events:none;
      z-index:-10;
      filter:blur(120px);
      transition:filter 1.5s ease;
    }
    .bg-1 {
      background:radial-gradient(circle at 20% 20%, rgba(157,107,255,0.42), transparent 70%);
      animation:bg1 18s infinite alternate ease-in-out;
    }
    .bg-2 {
      background:radial-gradient(circle at 80% 40%, rgba(0,198,255,0.35), transparent 70%);
      animation:bg2 22s infinite alternate ease-in-out;
    }
    .bg-3 {
      background:radial-gradient(circle at 50% 80%, rgba(255,77,222,0.30), transparent 70%);
      animation:bg3 26s infinite alternate ease-in-out;
    }
    @keyframes bg1 { from{transform:translate(-5%,-5%) scale(1);} to{transform:translate(4%,6%) scale(1.25);} }
    @keyframes bg2 { from{transform:translate(5%,-5%) scale(1.1);} to{transform:translate(-4%,8%) scale(1.3);} }
    @keyframes bg3 { from{transform:translateY(0) scale(1);} to{transform:translateY(6%) scale(1.35);} }

    header {
      position:fixed;
      top:0; left:0;
      width:100%;
      padding:20px 40px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      backdrop-filter:blur(24px) saturate(1.4);
      background:rgba(255,255,255,0.5);
      border-bottom:1px solid rgba(255,255,255,0.55);
      box-shadow:0 10px 40px rgba(0,0,0,0.06);
      transition:0.4s ease;
      z-index:1000;
    }
    header.active {
      padding:14px 40px;
      background:rgba(255,255,255,0.80);
      box-shadow:0 18px 60px rgba(0,0,0,0.12);
    }
    nav ul { display:flex; gap:28px; list-style:none; }
    nav a { font-weight:500; transition:0.25s; }
    nav a:hover {
      color:var(--ai1);
      text-shadow:0 0 10px rgba(157,107,255,0.5);
    }

    section {
      padding:120px 40px;
    }
    .section-inner {
      max-width:1200px;
      margin:auto;
    }

    .page-title {
      font-size:38px;
      font-weight:800;
      margin-bottom:10px;
      letter-spacing:-1px;
    }
    .page-sub {
      font-size:17px;
      color:var(--sub);
      max-width:650px;
      line-height:1.7;
    }

    .reveal {
      opacity:0;
      transform:translateY(50px) scale(0.97);
      transition:1s cubic-bezier(.25,.6,.3,1);
    }
    .reveal.active {
      opacity:1;
      transform:translateY(0) scale(1);
    }

    .agents-grid {
      margin-top:40px;
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(310px,1fr));
      gap:32px;
    }

    .agent-card {
      position:relative;
      overflow:hidden;
      padding:32px;
      background:var(--glass1);
      backdrop-filter:blur(38px) saturate(1.7);
      border-radius:26px;
      border:1px solid rgba(255,255,255,0.55);
      box-shadow:0 24px 60px rgba(0,0,0,0.12);
      transform-style:preserve-3d;
      transition:0.45s;
    }

    .agent-card h3 {
      font-size:20px;
      margin-bottom:4px;
    }
    .agent-tag {
      display:inline-block;
      font-size:11px;
      text-transform:uppercase;
      letter-spacing:0.08em;
      opacity:0.7;
      margin-bottom:10px;
    }

    .agent-desc {
      font-size:14px;
      color:var(--sub);
      margin-bottom:10px;
      line-height:1.6;
    }

    .agent-capabilities {
      font-size:13px;
      margin-bottom:12px;
    }

    .agent-meta {
      font-size:12px;
      opacity:0.7;
    }

    .agent-footer {
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-top:16px;
      font-size:12px;
      opacity:0.8;
    }

    .pill {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:6px 12px;
      border-radius:999px;
      font-size:11px;
      background:linear-gradient(90deg,var(--ai1),var(--ai2));
      color:white;
    }

    /* light suivant souris */
    .agent-card::before {
      content:"";
      position:absolute;
      top:0; left:0;
      width:100%; height:100%;
      border-radius:inherit;
      background:radial-gradient(circle at var(--mx) var(--my),
          rgba(255,255,255,0.55), transparent 45%);
      pointer-events:none;
      opacity:0;
      transition:0.25s;
    }
    .agent-card:hover::before { opacity:1; }

    .agent-card::after {
      content:"";
      position:absolute;
      top:-150%; left:-150%;
      width:300%; height:300%;
      background:linear-gradient(135deg, transparent, rgba(255,255,255,0.18), transparent);
      transform:rotate(25deg);
      opacity:0;
      transition:1s;
    }
    .agent-card:hover::after {
      left:150%; top:150%;
      opacity:1;
    }

    .section-block {
      margin-top:60px;
    }

    .section-block h2 {
      font-size:24px;
      margin-bottom:10px;
    }
    .section-block p {
      font-size:15px;
      color:var(--sub);
      max-width:700px;
      line-height:1.7;
    }

    .cursor-halo {
      position:fixed;
      width:230px;
      height:230px;
      border-radius:50%;
      pointer-events:none;
      background:radial-gradient(circle,
                  rgba(157,107,255,0.28),
                  rgba(0,198,255,0.24),
                  transparent 70%);
      filter:blur(70px);
      transform:translate(-50%, -50%);
      z-index:-2;
      opacity:.9;
      transition:0.2s;
    }

    @media(max-width:900px){
      section { padding:90px 20px; }
      header { padding:16px 20px; }
    }
  </style>
</head>
<body>

  <div class="bg-layer bg-1"></div>
  <div class="bg-layer bg-2"></div>
  <div class="bg-layer bg-3"></div>
  <div class="cursor-halo"></div>

  <header>
    <div class="logo" style="font-size:22px;font-weight:800;">NH110LAB.ai</div>
    <nav>
      <ul>
        <li><a href="index.html">Accueil</a></li>
        <li><a href="#catalogue">Catalogue</a></li>
        <li><a href="#workflow">Workflow</a></li>
        <li><a href="#uses">Cas d’usage</a></li>
      </ul>
    </nav>
  </header>

  <section id="catalogue" class="reveal">
    <div class="section-inner">
      <h1 class="page-title">Catalogue d’Agents IA</h1>
      <p class="page-sub">
        Une collection d’agents spécialisés, prêts à être adaptés à votre activité : prospection, support, analyse, opérations, pilotage.
      </p>

      <div class="agents-grid">

        <div class="agent-card">
          <span class="agent-tag">Prospection · B2B / B2C</span>
          <h3>Prospector+</h3>
          <p class="agent-desc">
            Recherche de prospects, enrichissement de profils, priorisation par score, rédaction de messages personnalisés, relances programmées.
          </p>
          <p class="agent-capabilities">
            Capable d’analyser un secteur, filtrer les contacts pertinents, adapter le ton selon le niveau de maturité (froid, tiède, chaud).
          </p>
          <p class="agent-meta">
            Sources : LinkedIn, CRM, formulaires entrants, listes existantes.<br>
            Sorties : fiches prospects enrichies, séquences d’emails ou messages.
          </p>
          <div class="agent-footer">
            <span>Temps gagné / semaine&nbsp;: 3 à 8h</span>
            <span class="pill">Agent de prospection</span>
          </div>
        </div>

        <div class="agent-card">
          <span class="agent-tag">Documents · PDF / contrats</span>
          <h3>DocReader IA</h3>
          <p class="agent-desc">
            Lit vos contrats, devis, factures, CGV ou comptes-rendus et vous renvoie l’essentiel sans jargon, avec des points de vigilance.
          </p>
          <p class="agent-capabilities">
            Extraction des montants, dates, parties, obligations, risques potentiels, synthèses par mail ou dans votre outil préféré.
          </p>
          <p class="agent-meta">
            Connecteurs : stockage cloud, drive interne, mail, CRM.<br>
            Utilisation : analyse juridique rapide, vérification des pièces, pré-lecture client.
          </p>
          <div class="agent-footer">
            <span>Temps gagné / document&nbsp;: 10 à 30 min</span>
            <span class="pill">Agent documentaire</span>
          </div>
        </div>

        <div class="agent-card">
          <span class="agent-tag">Relation client · CRM</span>
          <h3>CRM Sync</h3>
          <p class="agent-desc">
            Nettoie, enrichit et maintient votre CRM à jour : détection de doublons, clients dormants, opportunités oubliées, relances ciblées.
          </p>
          <p class="agent-capabilities">
            Génération d’actions à faire, relances planifiées, rappels pour vos équipes, suivi des réponses pour adapter les scénarios.
          </p>
          <p class="agent-meta">
            Fonctionne avec : HubSpot, Pipedrive, Notion, Airtable, etc.<br>
            Mode : suggestion ou exécution semi-automatique selon votre préférence.
          </p>
          <div class="agent-footer">
            <span>Valeur&nbsp;: pipeline plus propre, relances systématiques</span>
            <span class="pill">Agent CRM</span>
          </div>
        </div>

        <div class="agent-card">
          <span class="agent-tag">Support 24/7 · FAQ interne</span>
          <h3>SupportFlow</h3>
          <p class="agent-desc">
            Prend en charge les demandes récurrentes des clients, répond à partir de votre base de connaissances et escalade vers un humain en cas de doute.
          </p>
          <p class="agent-capabilities">
            Compréhension du ton de la marque, réponses multilingues, capacité à reconnaître les cas sensibles à transférer à un conseiller.
          </p>
          <p class="agent-meta">
            Canaux : chat web, email, WhatsApp, back-office interne.<br>
            Effet : baisse du volume de tickets simples, amélioration des délais de réponse.
          </p>
          <div class="agent-footer">
            <span>Réduction tickets simples&nbsp;: 30–60%</span>
            <span class="pill">Agent de support</span>
          </div>
        </div>

        <div class="agent-card">
          <span class="agent-tag">Technique · Automobile</span>
          <h3>AutoTech IA</h3>
          <p class="agent-desc">
            Interprète les codes défaut OBD, propose des pistes de diagnostic, génère des explications claires pour les clients non techniques.
          </p>
          <p class="agent-capabilities">
            Traduction des codes en langage humain, propositions de vérifications, estimation de la gravité, préparation du compte-rendu.
          </p>
          <p class="agent-meta">
            Utilisation : garages, centres auto, indépendants.<br>
            Fonctionne avec : exports OBD, photos, descriptions textuelles.
          </p>
          <div class="agent-footer">
            <span>Expérience client + crédibilité renforcée</span>
            <span class="pill">Agent tech auto</span>
          </div>
        </div>

        <div class="agent-card">
          <span class="agent-tag">Pilotage · Direction</span>
          <h3>Data Insight</h3>
          <p class="agent-desc">
            Lit vos chiffres (ventes, leads, coûts, récurrence), détecte les anomalies, remonte les signaux faibles et propose un résumé actionnable.
          </p>
          <p class="agent-capabilities">
            Synthèse quotidienne ou hebdo, alertes en cas de chute / pic, suggestions de leviers à activer en priorité.
          </p>
          <p class="agent-meta">
            Source : CRM, fichier Excel, outils SaaS, exports.<br>
            Format : email, dashboard, messages courts pour dirigeants pressés.
          </p>
          <div class="agent-footer">
            <span>Vision en continu ± temps réel</span>
            <span class="pill">Agent de pilotage</span>
          </div>
        </div>

      </div>

      <div id="workflow" class="section-block reveal">
        <h2>Comment ça se passe concrètement&nbsp;?</h2>
        <p>
          1. Vous choisissez un agent comme point de départ (par exemple Prospector+ ou SupportFlow).<br>
          2. On cartographie ensemble votre activité, vos outils, vos contraintes.<br>
          3. On adapte l’agent à votre réalité (ton, données, scénarios, exceptions).<br>
          4. On teste sur un petit périmètre, puis on élargit progressivement.<br>
          5. On suit les résultats et on itère pour l’aligner avec vos objectifs.
        </p>
      </div>

      <div id="uses" class="section-block reveal">
        <h2>Cas d’usage typiques</h2>
        <p>
          · Une agence qui veut automatiser sa prospection sans perdre le côté humain.<br>
          · Un indépendant qui croule sous les devis, factures et mails clients.<br>
          · Une petite structure qui n’a pas de service support dédié mais beaucoup de demandes récurrentes.<br>
          · Une entreprise qui a des données mais pas le temps de les lire au quotidien.<br><br>
          NH110LAB.ai sert de “laboratoire” pour tester et déployer ces agents de manière réaliste, sans blabla inutile.
        </p>
      </div>
    </div>
  </section>

  <canvas id="aiParticles" style="position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:-3;pointer-events:none;"></canvas>

  <script>
    /* HEADER shrink */
    window.addEventListener("scroll", () => {
      const h = document.querySelector("header");
      if (window.scrollY > 40) h.classList.add("active");
      else h.classList.remove("active");
    });

    /* REVEAL sections */
    const reveals = document.querySelectorAll(".reveal");
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add("active");
      });
    }, { threshold: 0.12 });
    reveals.forEach(el => io.observe(el));

    /* CURSOR HALO */
    const halo = document.querySelector(".cursor-halo");
    document.addEventListener("mousemove", (e) => {
      halo.style.left = e.pageX + "px";
      halo.style.top = e.pageY + "px";
    });

    /* PARALLAX background layers */
    const layers = document.querySelectorAll(".bg-layer");
    window.addEventListener("mousemove", (e) => {
      const rx = (e.clientX / window.innerWidth - 0.5) * 20;
      const ry = (e.clientY / window.innerHeight - 0.5) * 20;
      layers.forEach((layer, i) => {
        const depth = (i + 1) * 12;
        layer.style.transform = `translate(${rx / depth}px, ${ry / depth}px)`;
      });
    });

    /* Tilt 3D + light sur les agent-card */
    document.querySelectorAll(".agent-card").forEach(card => {
      card.addEventListener("mousemove", (e) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width;
        const y = (e.clientY - rect.top) / rect.height;

        const tiltX = (y - 0.5) * 18;
        const tiltY = (x - 0.5) * -18;

        card.style.transform =
          `perspective(900px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) scale(1.04)`;

        card.style.setProperty("--mx", `${x * 100}%`);
        card.style.setProperty("--my", `${y * 100}%`);
      });

      card.addEventListener("mouseleave", () => {
        card.style.transform = "perspective(900px) rotateX(0deg) rotateY(0deg) scale(1)";
      });
    });

    /* Particules IA façon Siri */
    const canvas = document.getElementById("aiParticles");
    const ctx = canvas.getContext("2d");
    let w, h;
    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener("resize", resize);

    const particles = [];
    const COUNT = 60;

    function createParticle() {
      const size = Math.random() * 3 + 2;
      const speed = Math.random() * 0.5 + 0.2;
      return {
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * speed,
        vy: (Math.random() - 0.5) * speed,
        size,
        color: Math.random() > 0.66
          ? "rgba(157,107,255,0.7)"
          : Math.random() > 0.33
          ? "rgba(0,198,255,0.7)"
          : "rgba(255,77,222,0.7)"
      };
    }

    for (let i = 0; i < COUNT; i++) particles.push(createParticle());

    function animateParticles() {
      ctx.clearRect(0, 0, w, h);
      particles.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.shadowBlur = 15;
        ctx.shadowColor = p.color;
        ctx.fill();
      });
      requestAnimationFrame(animateParticles);
    }
    animateParticles();

    /* Thème clair / sombre simple : sombre si on n'est plus en haut de page */
    function updateTheme() {
      if (window.scrollY > 200) document.body.classList.add("theme-dark");
      else document.body.classList.remove("theme-dark");
    }
    window.addEventListener("scroll", updateTheme);
    window.addEventListener("load", updateTheme);
  </script>
</body>
</html>
